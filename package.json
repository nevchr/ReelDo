{
  "name": "reel-do",
  "version": "0.5.0",
  "private": true,
  "description": "Organize saved Instagram reels and imported TikTok favourites into local topic lists.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/package.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node tests/ui.mjs",
    "test:extension": "node tests/extension.mjs",
    "test:capture": "node tests/capture-runtime.mjs",
    "start": "node scripts/serve.mjs",
    "test:lists": "node tests/lists-ui.mjs",
    "test:appearance": "node tests/appearance.mjs",
    "test:tiktok": "node tests/tiktok-runtime.mjs",
    "test:tiktok-scan": "node tests/tiktok-scan-runtime.mjs"
  },
  "type": "module",
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "vite": "^7.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@playwright/test": "^1.55.0",
    "esbuild": "^0.28.2"
  }
}
